{
  "oneOf": [
    { "$ref": "#/$defs/recipe" },
    {
      "type": "object",
      "required": ["recipes"],
      "properties": {
        "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } }
      }
    },
    { "type": "array", "items": { "$ref": "#/$defs/recipe" } }
  ],
  "$defs": {
    "recipe": {
      "type": "object",
      "required": ["title", "ingredients", "steps"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "type": "string", "const": "recipe-extraction/v1" },
        "title": { "type": "string", "maxLength": 255 },
        "description": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^https?://" },
            "name": { "type": "string", "maxLength": 255 },
            "type": { "enum": ["VIDEO", "WEB", "BOOK", "ORIGINAL"] }
          }
        },
        "imageUrl": { "type": "string", "pattern": "^https?://" },
        "servings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "maxLength": 64 }
          }
        },
        "times": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prepMinutes": { "type": "integer", "minimum": 0 },
            "cookMinutes": { "type": "integer", "minimum": 0 },
            "totalMinutes": { "type": "integer", "minimum": 0 }
          }
        },
        "difficulty": { "enum": ["EASY", "MEDIUM", "HARD"] },
        "category": { "type": "string", "maxLength": 80 },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredient" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "notes": { "type": "string" },
        "favorite": { "type": "boolean" }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 64,
          "description": "Stable key referenced by step.uses. Never a positional index."
        },
        "name": { "type": "string", "maxLength": 255 },
        "quantity": {
          "type": "number",
          "description": "Numbers only. 'to taste' belongs in note, with quantity omitted."
        },
        "quantityMax": { "type": "number", "description": "Upper bound of a range." },
        "unit": { "type": "string", "maxLength": 48 },
        "note": { "type": "string", "maxLength": 255 },
        "section": { "type": "string", "maxLength": 120 },
        "optional": { "type": "boolean" },
        "scalable": { "type": "boolean", "default": true },
        "rawText": { "type": "string", "maxLength": 512, "description": "Original line, kept verbatim." }
      }
    },
    "step": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "title": { "type": "string", "maxLength": 255 },
        "section": { "type": "string", "maxLength": 120 },
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "temperature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": "number" },
            "unit": { "enum": ["C", "F"] }
          }
        },
        "imageUrl": { "type": "string", "pattern": "^https?://" },
        "uses": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ingredient.ref values consumed by this step."
        }
      }
    }
  }
}
